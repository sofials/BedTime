  enablePreDialogueEvents: 0
  preDialogueEvents: []
  enablePostDialogueEvents: 0
  postDialogueEvents: []
  maxPreDialogueDelay: 3
  dialogueLines:
  - text: "Uhhh\u2026 okay. That thing\u2019s spinning way too fast.\r\nI mean, I\u2019d
      love to get through it, but I\u2019m kind of attached to having all my limbs.\r"
    audioClip: {fileID: 8300000, guid: f153d512853364543840da0bd46d559b, type: 3}
    hasLineEvents: 0
    lineEvents: []
  - text: "Is time for a little birthday present: I\u2019ll teach you some tricks\r\nWhat
      moves too fast for the eye\u2026 can still be slowed by the mind. Focus, Luke.
      In this world, time bends for his Dreamer.\r"
    audioClip: {fileID: 8300000, guid: 1c5c1d9c2e1ac5c49bfcf317878903c7, type: 3}
    hasLineEvents: 0
    lineEvents: []
  - text: "Alright, dream-magic slowdown powers. Don\u2019t fail me now."
    audioClip: {fileID: 8300000, guid: 9c6c37ae77662de40b0001e031ea6a85, type: 3}
    hasLineEvents: 0
    lineEvents: []
