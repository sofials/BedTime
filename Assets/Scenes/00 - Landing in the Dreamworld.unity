--- !u!114 &640090560
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 640090558}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b00cdb08e973d2641ac897726687ff00, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueUI: {fileID: 2262713334296749978}
  dialogueText: {fileID: 6172549788643549503}
  enableLineEvents: 0
  globalLineEvents: []
  prioritizeDialogueLineEvents: 1
  enablePreDialogueEvents: 0
  preDialogueEvents: []
  enablePostDialogueEvents: 0
  postDialogueEvents: []
  maxPreDialogueDelay: 3
  dialogueLines:
  - text: "You know what? I\u2019ve got a good feeling about today.\r\r\nSky dragons,
      living castles, talking sandwiches\u2014let\u2019s make something big!\r"
    audioClip: {fileID: 8300000, guid: cbd468966ec68bd42b0ac64bed41b112, type: 3}
    hasLineEvents: 0
    lineEvents: []
  - text: 'First things first, hero.

      You must go to Luketown. Without delay.'
    audioClip: {fileID: 8300000, guid: 2a4f87bd3bc51f24a8076d6d8e84e951, type: 3}
    hasLineEvents: 0
    lineEvents: []
  - text: "Luketown? But its villagers are\u2026 you know\u2026 obsessed with me!
      I can\u2019t even remember why we created them like that!\r\nYou sure we can\u2019t
      squeeze in one flying sandwich?"
    audioClip: {fileID: 8300000, guid: e5d5c97e8c8479143b6fad2a712c6a68, type: 3}
    hasLineEvents: 0
    lineEvents: []
  - text: "Trust me, Minis have something quite special waiting for you there.\r
      \r                                                  \nSomething that might
      just change the course of your journey.\r"
    audioClip: {fileID: 8300000, guid: 36b77b339f1e67f4297a1ea0d3d5f270, type: 3}
    hasLineEvents: 0
    lineEvents: []
  - text: Oh? Like a flying sandwich that grants wishes?
    audioClip: {fileID: 8300000, guid: 39f3dd13d5c839340ba4dd6d3a5e55d8, type: 3}
    hasLineEvents: 0
    lineEvents: []
  - text: "Not quite. But maybe even better.\r\n> \rSecrets, challenges... and a
      few surprises only a true hero deserves."
    audioClip: {fileID: 8300000, guid: 35eb943f0ba6afb42b06099fef4af27f, type: 3}
    hasLineEvents: 0
    lineEvents: []
  - text: "Alright, Luketown it is. But if I see a sandwich, I\u2019m grabbing it
      and fly away from that weirdoes."
    audioClip: {fileID: 8300000, guid: b92b3b45bb0e54944a4f3a6fefa1d503, type: 3}
    hasLineEvents: 0
    lineEvents: []
  - text: 'Fair enough. Now go: adventure awaits!'
    audioClip: {fileID: 8300000, guid: 0fa20ae474fafbf48adc494f935361b1, type: 3}
    hasLineEvents: 0
    lineEvents: []
