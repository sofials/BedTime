--- !u!114 &2134550628
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2134550626}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b00cdb08e973d2641ac897726687ff00, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueUI: {fileID: 2262713334296749978}
  dialogueText: {fileID: 6172549788643549503}
  enableLineEvents: 0
  globalLineEvents: []
  prioritizeDialogueLineEvents: 1
  enablePreDialogueEvents: 0
  preDialogueEvents: []
  enablePostDialogueEvents: 0
  postDialogueEvents: []
  maxPreDialogueDelay: 3
  dialogueLines:
  - text: Whoa! What just happened?! The platform disappeared beneath me!
    audioClip: {fileID: 8300000, guid: 18557c33ec912e14c94cd178a432e7ab, type: 3}
    hasLineEvents: 0
    lineEvents: []
  - text: "Hmm\u2026 That platform might have had a little hiccup during its creation.\r
      \r                                                                                                                                       
      Nothing to worry about\u2014dreams can be... unpredictable sometimes.\r"
    audioClip: {fileID: 8300000, guid: a168c3f0cb8f82042a165b30cf846679, type: 3}
    hasLineEvents: 0
    lineEvents: []
  - text: Not to worry? I fell! That was dangerous! How can I trust this world if
      the ground just vanishes?
    audioClip: {fileID: 8300000, guid: 5344b55d799dafc43a6b0ec2894a2d09, type: 3}
    hasLineEvents: 0
    lineEvents: []
  - text: "I truly don\u2019t know what caused it. \nPerhaps a rare flaw... or a
      trick of the dream\u2019s weave.\nLet\u2019s focus on moving forward, shall
      we? Luckily, I have something better than that boring terrain."
    audioClip: {fileID: 8300000, guid: b2f8f3bf94f25a545af27c1e2fd07f6a, type: 3}
    hasLineEvents: 0
    lineEvents: []
  canRepeatDialogue: 0
  autoCloseOnExit: 0
  autoFinishLastLine: 1
  autoFinishDelay: 2
  enableSubDialogue: 1
  subDialogueSystem: {fileID: 1873867257}
  subDialogueDelay: 0.5
  subDialogueMessage: 
  enableDissolveEffect: 1
  dissolveObjects:
  - targetObject: {fileID: 70356839}
    dissolveMaterials:
    - {fileID: 2100000, guid: 5e2c693c163751d409a58776abecc570, type: 2}
    - {fileID: 2100000, guid: 40e137077214866418f0670b5fe47320, type: 2}
    - {fileID: 2100000, guid: 390dbde854a623f4d8d5b7146150b7dd, type: 2}
