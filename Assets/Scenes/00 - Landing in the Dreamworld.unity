  postDialogueEvents: []
  maxPreDialogueDelay: 3
  dialogueLines:
  - text: "Here\u2014your new safe landing zone. Soft, sturdy, and\u2026 slightly
      more reliable."
    audioClip: {fileID: 8300000, guid: 6f0b66570eec79f409ae273c3e63b164, type: 3}
    hasLineEvents: 0
    lineEvents: []
  - text: "Well, it\u2019s not exactly what I imagined for an epic quest, but I\u2019ll
      take it."
    audioClip: {fileID: 8300000, guid: da4a86d57f3af5c449d63a93f37c4a2b, type: 3}
    hasLineEvents: 0
    lineEvents: []
  - text: Even heroes need a soft spot now and then.
