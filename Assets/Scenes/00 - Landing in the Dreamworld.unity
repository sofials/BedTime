  postDialogueEvents: []
  maxPreDialogueDelay: 3
  dialogueLines:
  - text: "Wait\u2026 I know this piece!\r                                            
      \nIt\u2019s from the puzzle we started at home! A thousand pieces, but we never
      finished it.\r\nMaybe here\u2026 I can find more...\r"
    audioClip: {fileID: 8300000, guid: a6244432ef501c048ac410667a118aab, type: 3}
