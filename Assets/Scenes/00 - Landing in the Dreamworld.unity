  enableLineEvents: 0
  globalLineEvents: []
  prioritizeDialogueLineEvents: 1
  enablePreDialogueEvents: 0
  preDialogueEvents: []
  enablePostDialogueEvents: 0
  postDialogueEvents: []
  maxPreDialogueDelay: 3
  dialogueLines:
  - text: "Tell me, Dreamer\u2014what will you do to celebrate your birthday tomorrow,
      in the waking world?"
    audioClip: {fileID: 8300000, guid: 9e57f15761f80b04897c204d561b1430, type: 3}
    hasLineEvents: 0
    lineEvents: []
  - text: Dunno. Probably cake. Maybe pizza. Avoid homework. Standard heroic stuff.
    audioClip: {fileID: 8300000, guid: b8e4d18a19babeb4698abdea2c2ce0da, type: 3}
    hasLineEvents: 0
    lineEvents: []
  - text: "Ah, yes. The trials of the mortal realm\u2026 far more treacherous than
      shadow beasts."
    audioClip: {fileID: 8300000, guid: c191a797a68e0874e965d1d128615f5c, type: 3}
    hasLineEvents: 0
    lineEvents: []
  - text: You joke, but have you seen math class?
    audioClip: {fileID: 8300000, guid: 3d86c8779d110564e81cba2d8939b68b, type: 3}
    hasLineEvents: 0
    lineEvents: []
  canRepeatDialogue: 0
