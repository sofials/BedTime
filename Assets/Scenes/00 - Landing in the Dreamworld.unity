  enablePreDialogueEvents: 0
  preDialogueEvents: []
  enablePostDialogueEvents: 0
  postDialogueEvents: []
  maxPreDialogueDelay: 3
  dialogueLines:
  - text: "There\u2026 Do you see it?\r\nA memory twisted into malice. A fear given
      form.\r\nYour first nightmare made flesh."
    audioClip: {fileID: 8300000, guid: 95f8b2995af237f4984c4bac794fb3af, type: 3}
    hasLineEvents: 0
    lineEvents: []
  - text: "Huh. I was hoping my first monster would be\u2026 a little bit scarier."
    audioClip: {fileID: 8300000, guid: 187895ac8faf27847838e1e55c95c49e, type: 3}
    hasLineEvents: 0
    lineEvents: []
  - text: "Fear rarely has the shape we expect, Dreamer. \r\nNow face it, I\u2019ll
      be here Luke."
    audioClip: {fileID: 8300000, guid: cd7d90dd6c54ff240ab38cf4776a76c9, type: 3}
    hasLineEvents: 0
    lineEvents: []
  canRepeatDialogue: 0
  autoCloseOnExit: 0
