--- !u!114 &1030388563
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1030388561}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b00cdb08e973d2641ac897726687ff00, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueUI: {fileID: 796150842}
  dialogueText: {fileID: 796150844}
  enableLineEvents: 0
  globalLineEvents: []
  prioritizeDialogueLineEvents: 1
  enablePreDialogueEvents: 0
  preDialogueEvents: []
  enablePostDialogueEvents: 0
  postDialogueEvents: []
  maxPreDialogueDelay: 3
  dialogueLines:
  - text: Whoa! That platform just vanished! Why does it keep on happening??
    audioClip: {fileID: 8300000, guid: 128ede73cb5669b46a91d9818c7e25a5, type: 3}
    hasLineEvents: 0
    lineEvents: []
  - text: "Well\u2026 sometimes dreams don\u2019t choose themselves, Luke. They know
      what they need all on their own."
    audioClip: {fileID: 8300000, guid: 87b4e930302e0284885fb51859a86f7d, type: 3}
    hasLineEvents: 0
    lineEvents: []
  - text: "This place is changing. But don\u2019t worry, I\u2019m here with you."
    audioClip: {fileID: 8300000, guid: 05b0bd38709bcd6438b4401a39ba61fb, type: 3}
    hasLineEvents: 0
    lineEvents: []
  - text: "Now, listen closely \u2014 you\u2019ve got a new power. You can create
      a platform right in front of you to cross gaps like this."
    audioClip: {fileID: 8300000, guid: 250425e1a72384048bdb5dceb1de40b1, type: 3}
    hasLineEvents: 0
    lineEvents: []
  - text: Try it out! Just focus, and a solid platform will appear where you need
      it most.
    audioClip: {fileID: 8300000, guid: 29a1e5c3f4ac161428dead77cb1e1022, type: 3}
    hasLineEvents: 0
    lineEvents: []
  canRepeatDialogue: 0
