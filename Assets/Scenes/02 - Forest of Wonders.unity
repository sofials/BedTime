  m_Script: {fileID: 11500000, guid: b00cdb08e973d2641ac897726687ff00, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueUI: {fileID: 796150842}
  dialogueText: {fileID: 796150844}
  enableLineEvents: 0
  globalLineEvents: []
  prioritizeDialogueLineEvents: 1
  enablePreDialogueEvents: 0
  preDialogueEvents: []
  enablePostDialogueEvents: 0
  postDialogueEvents: []
  maxPreDialogueDelay: 3
  dialogueLines:
  - text: "I\u2026 don\u2019t know how\u2026 to make stone things."
    audioClip: {fileID: 8300000, guid: b98aef9d5fa94c346993aafce2efb22c, type: 3}
    hasLineEvents: 0
    lineEvents: []
  - text: "But\u2026 me too\u2026 was made stone\u2026\n"
    audioClip: {fileID: 8300000, guid: 1dad452197abb504aad7657aaead3bee, type: 3}
    hasLineEvents: 0
    lineEvents: []
  - text: "Dreams\u2026 dreams don\u2019t choose\u2026 they just\u2026"
    audioClip: {fileID: 8300000, guid: 220e39bf4dbd162488620de7e5ba5e8c, type: 3}
    hasLineEvents: 0
    lineEvents: []
  - text: "They know\u2026 what they want\u2026 on their own\u2026"
    audioClip: {fileID: 8300000, guid: 3b2c964a92a0a22418715718d53b980b, type: 3}
    hasLineEvents: 0
    lineEvents: []
  - text: "Remember that\u2026 Luke\u2026"
    audioClip: {fileID: 8300000, guid: 052f471ba9baf35468d3d3c4a4e4cf5d, type: 3}
    hasLineEvents: 0
    lineEvents: []
  canRepeatDialogue: 0
