--- !u!114 &78918860282814194
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 403380823861136899}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b00cdb08e973d2641ac897726687ff00, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueUI: {fileID: 0}
  dialogueText: {fileID: 0}
  dialogueLines:
  - text: Happy birthday Dreamer!
    audioClip: {fileID: 8300000, guid: b8e59832a4798724bbd0c003b83a36b9, type: 3}
  - text: "Woah, thank you guys! But\u2026 why are you all so rushed?"
    audioClip: {fileID: 8300000, guid: 9473990b9b7719347b2db15c43cad946, type: 3}
  - text: "We\u2019ve been trying to get everyting ready before your arrival! \r\nBut\u2026
      we\u2019re still working on your third gift!\r\nWhy don\u2019t you go find
      the first two? They are hidden in the Playground Arena and Sweet Plaza!"
    audioClip: {fileID: 8300000, guid: 123f36762f07df440aa1b8052809fada, type: 3}
  - text: "Wait, so this whole chaotic dream mess was\u2026 a party? You people are
      dangerously enthusiastic!"
    audioClip: {fileID: 8300000, guid: c8fb9f95887b25c43a5fc4bb170b01f0, type: 3}
  - text: "They celebrate you as their guardian, Luke. Accept their joy\u2026 and
      face their trials.\r\n"
    audioClip: {fileID: 8300000, guid: 1435aaced83fc484a92e7bac524c0a6a, type: 3}
  - text: "Yeah, yeah\u2026 party trials. Do I get cake after all this?"
    audioClip: {fileID: 8300000, guid: aa6d95df6b19ba3488fd632b54feea0c, type: 3}
  - text: Only if you survive.
    audioClip: {fileID: 8300000, guid: 1de2c2187e9728044a487938fe83deb9, type: 3}
  - text: "Ugh\u2026\n"
    audioClip: {fileID: 8300000, guid: 22eb305805f77cf40bc92510d4a8a41f, type: 3}
  canRepeatDialogue: 0
  autoCloseOnExit: 0
