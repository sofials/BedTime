  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b00cdb08e973d2641ac897726687ff00, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueUI: {fileID: 0}
  dialogueText: {fileID: 0}
  dialogueLines:
  - text: "Teleporting dream magic: saving boys since five minutes ago!\r\n\u2026\r\nWhat\u2026?
      No no no\u2026 what happened? Who is that guy?!"
    audioClip: {fileID: 8300000, guid: 41793084567ecbd479950c5545cf2d67, type: 3}
  - text: "Luke\u2026 I can\u2019t understand\u2026"
    audioClip: {fileID: 8300000, guid: 6504c0bb320ff4347af82a719dda14ca, type: 3}
  - text: "He\u2019s running away! I don\u2019t care what it is, I\u2019m not letting
      it get away."
    audioClip: {fileID: 8300000, guid: 45d177298954a84468e504b6d73a759f, type: 3}
