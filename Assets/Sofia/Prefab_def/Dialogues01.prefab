  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b00cdb08e973d2641ac897726687ff00, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueUI: {fileID: 0}
  dialogueText: {fileID: 0}
  dialogueLines:
  - text: "Hey hey hey! You can\u2019t go this way yet!\r\nStill wrapping things
      up over there, NO PEEKING!\r\nGo enjoy Playground Arena and Sweet Plaza for
      now!"
    audioClip: {fileID: 8300000, guid: ee2b0789b5ed3af4cbb0ada40862beca, type: 3}
  - text: "Alright, alright, I\u2019ll stay out of your top-secret birthday zone\u2026
      for now.\r\n"
