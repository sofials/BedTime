  m_Name: 
  m_EditorClassIdentifier: 
  dialogueUI: {fileID: 0}
  dialogueText: {fileID: 0}
  dialogueLines:
  - text: "Whoa\u2026 what\u2019s going on here?"
    audioClip: {fileID: 8300000, guid: 04260505d6e84d64ab14dd8793478746, type: 3}
  - text: '(high-pitched, sped-up gibberish)  '
    audioClip: {fileID: 8300000, guid: 605e5e2958e66b34388b43eba466e11f, type: 3}
  - text: 'Hey! Can someone tell me- wait, slow down guys!!

      Lady, did I miss
      something or is everyone stuck on fast-forward??'
    audioClip: {fileID: 8300000, guid: 4163cc4b9f47826439cc4b558839af69, type: 3}
  - text: "The Dreamworld reflects energy, emotions\u2026 even anxiety. Calm the
      current, you know how, Luke\r\n"
    audioClip: {fileID: 8300000, guid: 51141ff057450bc4b8c8463d57984556, type: 3}
