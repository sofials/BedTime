--- !u!114 &4223677908283967491
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8791715544879469874}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b00cdb08e973d2641ac897726687ff00, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueUI: {fileID: 0}
  dialogueText: {fileID: 0}
  dialogueLines:
  - text: "Luke\u2026 your third gift is ready.\r \r\nI\u2019ve been looking forward
      to this one.\r\n"
    audioClip: {fileID: 8300000, guid: 512f37074f511f041acb2c60de193e30, type: 3}
  - text: Oh? What is it? Giant cupcake? Flying llama? Talking plant that gives life
      advice?
    audioClip: {fileID: 8300000, guid: 7075d490cb37b8645882462089b53b78, type: 3}
  - text: "Patience, hero.\r\r\nI won\u2019t spoil the surprise\u2014\r \r                                           
      but I can\u2019t wait to see your face.\r"
    audioClip: {fileID: 8300000, guid: 59085363c1e4b5144b361fee206cf0ee, type: 3}
  - text: "That\u2019s either very exciting\u2026 or very concerning.\r \r\nBut alright.
      Let\u2019s see what they got me.\r"
    audioClip: {fileID: 8300000, guid: 03238547e61a83542906c1d7293b627a, type: 3}
