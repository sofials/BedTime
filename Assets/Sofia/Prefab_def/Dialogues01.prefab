--- !u!114 &2469029923895776729
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8954546998698578497}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b00cdb08e973d2641ac897726687ff00, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueUI: {fileID: 0}
  dialogueText: {fileID: 0}
  dialogueLines:
  - text: "Whew\u2026 that place was intense.\r\r\nPretty sure I almost got hit in
      the face by a flying jellybean.\r"
    audioClip: {fileID: 8300000, guid: c968ea6c9ef878f4786f685daae4897b, type: 3}
  - text: You handled it well Dreamer.
    audioClip: {fileID: 8300000, guid: b56c80b79c3d82747a212c0c534c2817, type: 3}
  - text: "Still\u2014that pancake tower? Total distraction.\r\r\n I\u2019m starving
      now.\r\n"
    audioClip: {fileID: 8300000, guid: f2a12cc17939d61408e5396b50b87cdc, type: 3}
  - text: "You\u2019re lucky this gift isn\u2019t edible."
    audioClip: {fileID: 8300000, guid: 17c54409b5d291b41808cb08504e12c8, type: 3}
  - text: "Don\u2019t say that unless you\u2019re completely sure.\r\r\nI can\u2019t
      wait to unwrap it.\r"
    audioClip: {fileID: 8300000, guid: 4cb8e41e496b76c47829a02139ccd336, type: 3}
