--- !u!114 &4533144519476887682
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5817521589565730226}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b00cdb08e973d2641ac897726687ff00, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueUI: {fileID: 0}
  dialogueText: {fileID: 0}
  dialogueLines:
  - text: "Uh\u2026 Lady? What\u2019s going on here?!"
    audioClip: {fileID: 8300000, guid: e76fc74d32b99de46a554404cabd8e63, type: 3}
  - text: "This is\u2026 unexpected\u2026 I sensed no shift, no disruption\u2026\r\nBe
      careful Luke, let\u2019s go back in town."
    audioClip: {fileID: 8300000, guid: 2dbcf95d003e1df4ca5f047690377d4e, type: 3}
  - text: "But\u2026 how? I can\u2019t go anywhere!"
    audioClip: {fileID: 8300000, guid: 2fc9c6523d2c3ca4b8edc3fecbd59d35, type: 3}
  - text: "Don\u2019t worry, I have another trick for you: see that purple spot?\r\nIf
      you focus on it, you can teleport!"
    audioClip: {fileID: 8300000, guid: 284eab97c0199e446bff3a65b53e9d1e, type: 3}
  - text: "Wow and you just\u2026 kept it for yourself until now?"
    audioClip: {fileID: 8300000, guid: 98c3c6e6af0ffd34dbb55641fd9f659b, type: 3}
