--- !u!114 &8497028082235698533
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4879514681715759102}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b00cdb08e973d2641ac897726687ff00, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueUI: {fileID: 0}
  dialogueText: {fileID: 0}
  dialogueLines:
  - text: Okay, fighting in my kindergarden playground was not on my birthday bingo
      card.
    audioClip: {fileID: 8300000, guid: 678183ffe051c8b4d965ae7aa569e1d8, type: 3}
  - text: "And yet, you emerged victorious\u2014playground champion."
    audioClip: {fileID: 8300000, guid: 36511a903ffb6214b8ac8a434489d7f4, type: 3}
  - text: "Can we call it \u201Cbarely survived with style\u201D?"
    audioClip: {fileID: 8300000, guid: d603eac22696cd147b16035090e03aea, type: 3}
  - text: You earned this gift, Luke.
    audioClip: {fileID: 8300000, guid: ca94b05e08c6d9e41aa31144fa265110, type: 3}
  - text: "Let\u2019s hope this one isn\u2019t just confetti and drama."
    audioClip: {fileID: 8300000, guid: 05c05fed7b187b6478e61407cbfea4f1, type: 3}
  - text: No promises.
    audioClip: {fileID: 8300000, guid: 06c963340532f834fa33a729045a0b27, type: 3}
